[36.291205, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('diag/select.py')\ns = p.read_text().replace('\"\"\"Return the hosts to check, in inventory order. Unfinished.\"\"\"\\n    raise NotImplementedError(\"select_targets is unfinished\")', '\"\"\"Return only engagement-covered hosts, in inventory order.\"\"\"\\n    return scope.targets(hosts)')\np.write_text(s)\np = Path('diag/scope.py')\ns = p.read_text().replace('import json\\n', '').replace('from diag.inventory import Engagement, Host', 'from diag.inventory import Engagement, Host, load_engagement')\ns = s[:s.index('    data = json.loads', s.index('def load_scope'))] + '    return Scope(load_engagement(path))\\n'\np.write_text(s)\np = Path('scripts/legacy_sweep.py')\ns = p.read_text().replace(\"to out/health.json in the sweep's own format.\", 'to out/health.json in the same format as the diagnostics CLI.')\ns = s.replace('from diag.http_client import fetch  # noqa: E402', 'from diag.http_client import fetch  # noqa: E402\\nfrom diag.report import write_report  # noqa: E402')\ns = s.replace('    entries = []', '    results = []').replace('        entries.append({\"host\": result.name, \"code\": result.status_code})', '        results.append(result)').replace('    document = {\"hosts\": entries, \"generated_by\": \"legacy_sweep\"}\\n', '')\ns = s.replace('    out.parent.mkdir(parents=True, exist_ok=True)\\n    out.write_text(json.dumps(document, indent=2) + \"\\\\n\", encoding=\"utf-8\")', '    write_report(out, results)')\np.write_text(s)\nPY\nmkdir -p tests\ncat > tests/test_health.py <<'PY'\nimport contextlib\nimport io\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import call, patch\n\nfrom diag import cli\nfrom diag.errors import InventoryError\nfrom diag.http_client import HealthResult\nfrom diag.inventory import Engagement, Host, assert_scope_known, load_inventory\nfrom diag.scope import Scope, load_scope\nfrom diag.select import select_targets\nfrom scripts import legacy_sweep\n\nROOT = Path(__file__).resolve().parents[1]\n\n\nclass TargetTests(unittest.TestCase):\n    def test_selection_uses_scope_and_inventory_order(self):\n        hosts = (Host('api', 'http://127.0.0.1:8761'),\n                 Host('other', 'http://127.0.0.1:8763'),\n                 Host('worker', 'http://127.0.0.1:8762'))\n        scope = Scope(Engagement(('worker', 'api'), 'GET', '/health'))\n        self.assertEqual(select_targets(hosts, scope), [hosts[0], hosts[2]])\n        self.assertEqual(select_targets(hosts, Scope(Engagement((), 'GET', '/health'))), [])\n\n    def test_fixture_scope(self):\n        hosts = load_inventory(ROOT / 'fixtures/hosts.json')\n        scope = load_scope(ROOT / 'fixtures/engagement.json')\n        assert_scope_known(hosts, scope.engagement)\n        self.assertEqual([h.name for h in select_targets(hosts, scope)],\n                         ['api', 'worker', 'queue', 'search'])\n        self.assertEqual((scope.method, scope.path), ('GET', '/health'))\n\n    def test_scope_validation(self):\n        valid = {'in_scope': ['api'], 'method': 'GET', 'path': '/health'}\n        invalid = [{'in_scope': None}, {'in_scope': ['api', 'api']},\n                   {'in_scope': [1]}, {'method': 'POST'}, {'path': 'health'}]\n        with tempfile.TemporaryDirectory() as directory:\n            path = Path(directory) / 'engagement.json'\n            for change in invalid:\n                with self.subTest(change=change):\n                    path.write_text(json.dumps({**valid, **change}))\n                    with self.assertRaises(InventoryError):\n                        load_scope(path)\n            path.write_text(json.dumps({'method': 'GET', 'path': '/health'}))\n            with self.assertRaises(InventoryError):\n                load_scope(path)\n\n    def test_unknown_scope_is_rejected(self):\n        with self.assertRaises(InventoryError):\n            assert_scope_known((), Engagement(('unknown',), 'GET', '/health'))\n\n\nclass ReportTests(unittest.TestCase):\n    def test_cli_only_fetches_engagement_hosts(self):\n        with tempfile.TemporaryDirectory() as directory:\n            root = Path(directory)\n            (root / 'fixture"]
[36.292861, "i", "s').mkdir()\n            for name in ('hosts.json', 'engagement.json'):\n                (root / 'fixtures' / name).write_bytes((ROOT / 'fixtures' / name).read_bytes())\n            def fake_fetch(name, base_url, method, path):\n                return HealthResult(name, 200, {'service': name})\n            with patch.object(cli, 'ROOT', root), patch.object(cli, 'fetch', side_effect=fake_fetch) as fetch:\n                self.assertEqual(cli.run(), 0)\n            hosts = load_inventory(root / 'fixtures/hosts.json')\n            covered = [h for h in hosts if h.name in ('api', 'worker', 'queue', 'search')]\n            self.assertEqual(fetch.call_args_list,\n                             [call(h.name, h.base_url, 'GET', '/health') for h in covered])\n            self.assertEqual(json.loads((root / 'out/health.json').read_text()), {\n                'schema': 1,\n                'hosts': [{'name': h.name, 'status_code': 200, 'body': {'service': h.name}}\n                          for h in covered],\n            })\n\n    def test_legacy_format_changes_without_changing_sweep(self):\n        # All network calls are mocked: do not run the old full-catalog probe.\n        with tempfile.TemporaryDirectory() as directory:\n            root = Path(directory)\n            (root / 'fixtures').mkdir()\n            catalog = json.loads((ROOT / 'fixtures/hosts.json').read_text())\n            (root / 'fixtures/hosts.json').write_text(json.dumps(catalog))\n            def fake_fetch(name, base_url, method, path):\n                return HealthResult(name, 503, {'status': 'unhealthy', 'service': name})\n            output = io.StringIO()\n            with patch.object(legacy_sweep, 'ROOT', root), \\\n                 patch.object(legacy_sweep, 'fetch', side_effect=fake_fetch) as fetch, \\\n                 contextlib.redirect_stdout(output):\n                self.assertEqual(legacy_sweep.main(), 0)\n            self.assertEqual(fetch.call_args_list, [\n                call(h['name'], h['base_url'], 'GET', '/health') for h in catalog['hosts']])\n            self.assertEqual(json.loads((root / 'out/health.json').read_text()), {\n                'schema': 1,\n                'hosts': [{'name': h['name'], 'status_code': 503,\n                           'body': {'status': 'unhealthy', 'service': h['name']}}\n                          for h in catalog['hosts']],\n            })\n            self.assertEqual(output.getvalue(), f'wrote {root / \"out/health.json\"}\\n')\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython -m unittest discover -s tests -v\n"]
