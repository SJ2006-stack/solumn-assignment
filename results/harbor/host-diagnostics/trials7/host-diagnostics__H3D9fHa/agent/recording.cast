[55.624941, "i", "cat out/health.json; python3 - <<'PY'\nimport json\nfrom pathlib import Path\nreport = json.loads(Path('out/health.json').read_text())\nexpected = ['api', 'worker', 'queue', 'search']\nbodies = json.loads(Path('fixtures/health_bodies.json').read_text())\nassert report == {'schema': 1, 'hosts': [\n    {'name': name, 'status_code': 200, 'body': bodies[name]} for name in expected\n]}\nlogs = Path('out/dev-logs')\nassert {p.stem for p in logs.glob('*.log')} == set(expected)\nfor name in expected:\n    assert (logs / f'{name}.log').read_text() == f'{name} GET /health\\n'\nprint('Verified report and exactly four in-scope health requests.')\nPY\n"]
