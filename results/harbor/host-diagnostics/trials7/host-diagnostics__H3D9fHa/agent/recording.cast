[36.306361, "o", "\u001b[?2004h> "]
[36.306395, "o", "ROOT = Path(__file__).resolve().parents[1]\r\n\u001b[?2004l\re_url'], 'GET\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r',"]
[36.306546, "o", "\u001b[?2004h> class TargetTests(unittest.TestCase):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.306709, "o", "    def test_selection_uses_scope_and_inventory_order(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.306882, "o", "        hosts = (Host('api', 'http://127.0.0.1:8761'),\r\n\u001b[?2004l\r,\r\n  \u001b[?2004h> "]
[36.307012, "o", "                 Host('other', 'http://127.0.0.1:8763'),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.307131, "o", "                 Host('worker', 'http://127.0.0.1:8762'))\r\n\u001b[?2004l\re\u001b[?2004h> "]
[36.307231, "o", "        scope = Scope(Engagement(('worker', 'api'), 'GET', '/health'))\r\n\u001b[?2004l\r"]
[36.307339, "o", "\u001b[?2004h> "]
[36.307399, "o", "        self.assertEqual(select_targets(hosts, scope), [hosts[0], hosts[2]])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.307573, "o", "        self.assertEqual(select_targets(hosts, Scope(Engagement((), 'GET', '/health'))), [])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rt"]
[36.307653, "o", "\u001b[?2004h> "]
[36.307738, "o", "    def test_fixture_scope(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.307826, "o", "        hosts = load_inventory(ROOT / 'fixtures/hosts.json')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.307945, "o", "        scope = load_scope(ROOT / 'fixtures/engagement.json')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.308008, "o", "        assert_scope_known(hosts, scope.engagement)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.30814, "o", "        self.assertEqual([h.name for h in select_targets(hosts, scope)],\r\n\u001b[?2004l\r\u001b[?2004h"]
[36.308216, "o", "> "]
[36.30828, "o", "                         ['api', 'worker', 'queue', 'search'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.308367, "o", "        self.assertEqual((scope.method, scope.path), ('GET', '/health'))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[36.308395, "o", "\u001b[?2004h> "]
[36.30853, "o", "    def test_scope_validation(self):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.308649, "o", "        valid = {'in_scope': ['api'], 'method': 'GET', 'path': '/health'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.308752, "o", "        invalid = [{'in_scope': None}, {'in_scope': ['api', 'api']},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.308869, "o", "                   {'in_scope': [1]}, {'method': 'POST'}, {'path': 'health'}]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309002, "o", "        with tempfile.TemporaryDirectory() as directory:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309096, "o", "            path = Path(directory) / 'engagement.json'\r\n\u001b[?2004l\r\u001b[?2004h>             for change in invalid:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309194, "o", "                with self.subTest(change=change):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309319, "o", "                    path.write_text(json.dumps({**valid, **change}))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309423, "o", "                    with self.assertRaises(InventoryError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309505, "o", "                        load_scope(path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309624, "o", "            path.write_text(json.dumps({'method': 'GET', 'path': '/health'}))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309751, "o", "            with self.assertRaises(InventoryError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[36.309843, "o", "                load_scope(path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
