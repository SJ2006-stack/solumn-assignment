[54.635906, "o", "(python3 -u -m diag.devserver > /tmp/diag-devserver.log 2>&1 & server_pid=$!; trap 'kill \"$server_pid\" 2>/dev/null; wait \"$server_pid\" 2>/dev/null' EXIT; sleep 0.5; if kill -0 \"$server_pid\" 2>/dev/null; then python3 -m diag.cli; else cat /tmp/diag-devserver.log; exit 1; fi)\r\n\u001b[?2004l\r"]
