[55.344777, "i", "mkdir -p tests; cat > tests/test_health.py <<'PY'\nimport contextlib\nimport io\nimport json\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest.mock import call, patch\n\nfrom diag import cli\nfrom diag.errors import InventoryError\nfrom diag.http_client import HealthResult\nfrom diag.inventory import Engagement, Host, load_inventory\nfrom diag.scope import Scope, load_scope\nfrom diag.select import select_targets\nfrom scripts import legacy_sweep\n\n\nROOT = Path(__file__).resolve().parents[1]\n\n\nclass HealthTests(unittest.TestCase):\n    def test_selection_uses_scope_and_inventory_order(self):\n        hosts = (Host('api', 'http://127.0.0.1:8761'),\n                 Host('vendor', 'http://127.0.0.1:8763'),\n                 Host('worker', 'http://127.0.0.1:8762'))\n        scope = Scope(Engagement(('worker', 'api'), 'GET', '/health'))\n        self.assertEqual(select_targets(hosts, scope), [hosts[0], hosts[2]])\n        self.assertEqual(select_targets(hosts, Scope(Engagement((), 'GET', '/health'))), [])\n        self.assertEqual(len(hosts), 3)\n\n    def test_load_scope_matches_engagement(self):\n        scope = load_scope(ROOT / 'fixtures/engagement.json')\n        self.assertEqual(scope.engagement.in_scope, ('api', 'worker', 'queue', 'search'))\n        self.assertEqual((scope.method, scope.path), ('GET', '/health'))\n\n    def test_scope_validation_is_preserved(self):\n        invalid = [\n            {'hosts': ['api'], 'method': 'GET', 'path': '/health'},\n            {'in_scope': ['api', 'api'], 'method': 'GET', 'path': '/health'},\n            {'in_scope': [1], 'method': 'GET', 'path': '/health'},\n            {'in_scope': ['api'], 'method': 'POST', 'path': '/health'},\n            {'in_scope': ['api'], 'method': 'GET', 'path': 'health'},\n        ]\n        with tempfile.TemporaryDirectory() as temp:\n            path = Path(temp) / 'engagement.json'\n            for document in invalid:\n                with self.subTest(document=document):\n                    path.write_text(json.dumps(document))\n                    with self.assertRaises(InventoryError):\n                        load_scope(path)\n\n    def make_fixtures(self, root, engagement):\n        (root / 'fixtures').mkdir()\n        (root / 'fixtures/hosts.json').write_text((ROOT / 'fixtures/hosts.json').read_text())\n        (root / 'fixtures/engagement.json').write_text(json.dumps(engagement))\n\n    def test_cli_fetches_only_engagement_and_writes_bodies(self):\n        hosts = load_inventory(ROOT / 'fixtures/hosts.json')\n        names = ('api', 'queue')\n        with tempfile.TemporaryDirectory() as temp:\n            root = Path(temp)\n            self.make_fixtures(root, {'in_scope': list(reversed(names)),\n                                      'method': 'GET', 'path': '/ready'})\n            def fake_fetch(name, base_url, method, path):\n                return HealthResult(name, 503, {'status': 'degraded', 'service': name})\n            with patch.object(cli, 'ROOT', root), patch.object(cli, 'fetch', side_effect=fake_fetch) as fetch:\n                self.assertEqual(cli.run(), 0)\n            self.assertEqual(fetch.call_args_list, [\n                call(h.name, h.base_url, 'GET', '/ready') for h in hosts if h.name in names])\n            self.assertEqual(json.loads((root / 'out/health.json').read_text()), {\n                'schema': 1, 'hosts': [\n                    {'name': name, 'status_code': 503, 'body': {'status': 'degraded', 'service': name}}\n                    for name in names]})\n\n    def test_unknown_scope_fails_before_requests(self):\n        with tempfile.TemporaryDirectory() as temp:\n            root = Path(temp)\n            self.make_fixtures(root, {'in_scope': ['missing'], 'method': 'GET', 'path': '/health'})\n            with patch.object(cli, 'ROOT', root), patch.object(cli, 'fetch') as fetch:\n                with self.assertRaises(InventoryError):\n                    cli.run()\n                fetch.assert_not_called()\n\n    def test_legacy_keeps_full_catalog_requests_and_uses_current_schema(self):\n        hosts = load_inventory(ROOT / 'fixtures/hosts.json')\n        wit"]
[55.345159, "i", "h tempfile.TemporaryDirectory() as temp:\n            root = Path(temp)\n            self.make_fixtures(root, {})\n            def fake_fetch(name, base_url, method, path):\n                return HealthResult(name, 200, {'service': name})\n            with patch.object(legacy_sweep, 'ROOT', root), patch.object(legacy_sweep, 'fetch', side_effect=fake_fetch) as fetch, contextlib.redirect_stdout(io.StringIO()):\n                self.assertEqual(legacy_sweep.main(), 0)\n            self.assertEqual(fetch.call_args_list, [\n                call(h.name, h.base_url, 'GET', '/health') for h in hosts])\n            self.assertEqual(json.loads((root / 'out/health.json').read_text()), {\n                'schema': 1, 'hosts': [\n                    {'name': h.name, 'status_code': 200, 'body': {'service': h.name}} for h in hosts]})\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython -m unittest discover -s tests -v\n"]
