[88.803461, "i", "kill \"$DIAG_SERVER_PID\"; wait \"$DIAG_SERVER_PID\" 2>/dev/null || true\ncat diag/select.py diag/scope.py scripts/legacy_sweep.py\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\nreport = json.loads(Path('/app/out/health.json').read_text())\nassert report['schema'] == 1\nassert [host['name'] for host in report['hosts']] == ['api', 'worker', 'queue', 'search']\nfor host in report['hosts']:\n    assert set(host) == {'name', 'status_code', 'body'}\n    assert host['status_code'] == 200\n    assert host['body'] == {'status': 'ok', 'service': host['name']}\nprint('Verified /app/out/health.json')\nPY\n"]
[88.804424, "o", "kill \"$DIAG_SERVER_PID\"; wait \"$DIAG_SERVER_PID\" 2>/dev/null || true\r\n\u001b[?2004l\r"]
