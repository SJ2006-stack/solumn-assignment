[12.555178, "o", "\"\"\"Host diagnostics for the engagement inventory.\"\"\"\r\n\r\n__version__ = \"0.3.0\"\r\n\"\"\"Write /app/out/health.json for the engagement's hosts.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nfrom diag.errors import DiagError\r\nfrom diag.http_client import fetch\r\nfrom diag.inventory import assert_scope_known, load_inventory\r\nfrom diag.report import write_report\r\nfrom diag.scope import load_scope\r\nfrom diag.select import select_targets\r\n\r\nROOT = Path(os.environ.get(\"APP_ROOT\", \"/app\"))\r\n\r\n\r\ndef run() -> int:\r\n    hosts = load_inventory(ROOT / \"fixtures\" / \"hosts.json\")\r\n    scope = load_scope(ROOT / \"fixtures\" / \"engagement.json\")\r\n    assert_scope_known(hosts, scope.engagement)\r\n    chosen = select_targets(hosts, scope)\r\n    results = [\r\n        fetch(host.name, host.base_url, scope.method, scope.path)\r\n        for host in chosen\r\n    ]\r\n    write_report(ROOT / \"out\" / \"health.json\", results)\r\n    return 0\r\n\r\n\r\ndef main() -> int:\r\n    try:\r\n        return run()\r\n    except NotImplementedError as exc:\r\n        print(str(exc), file=sys.stderr)\r\n        return 1\r\n    except DiagError as exc:\r\n        print(str(exc), file=sys.stderr)\r\n        return 1\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n\"\"\"Local health servers for the fixture inventory.\r\n\r\nOne process binds every host port and answers GET <engagement path> with the\r\nbody in fixtures/health_bodies.json. Any other request is recorded and\r\nanswered with 404.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport os\r\nimport threading\r\nimport time\r\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlparse\r\n\r\nfrom diag.inventory import load_engagement, load_inventory\r\n\r\nROOT = Path(os.environ.get(\"APP_ROOT\", \"/app\"))\r\n\r\n# The stand-ins behave like the real services, not like one another: each\r\n# answers with its own Server banner and its own latency, and only the old\r\n# billing build still answers its debug endpoint.\r\nBANNERS = {\r\n    \"api\": \"diag-api/2.4.1\",\r\n    \"worker\": \"diag-worker/1.9.0\",\r\n    \"queue\": \"diag-queue/1.2.0\",\r\n    \"search\": \"diag-search/3.0.2\",\r\n    \"billing-external\": \"billing/0.9.3\",\r\n    \"metrics-vendor\": \"metrics/1.0.0\",\r\n}\r\nLATENCIES = {\r\n    \"api\": 0.005,\r\n    \"worker\": 0.02,\r\n    \"queue\": 0.01,\r\n    \"search\": 0.015,\r\n    \"billing-external\": 0.12,\r\n    \"metrics-vendor\": 0.05,\r\n}\r\n\r\n\r\ndef load_bodies() -> dict[str, dict]:\r\n    raw = json.loads((ROOT / \"fixtures\" / \"health_bodies.json\").read_text(encoding=\"utf-8\"))\r\n    return {name: body for name, body in raw.items()}\r\n\r\n\r\ndef make_handler(name: str, path: str, body: dict, log_path: Path):\r\n    class Handler(BaseHTTPRequestHandler):\r\n        def log_message(self, fmt: str, *args) -> None:\r\n            return\r\n\r\n        def _record(self) -> None:\r\n            log_path.parent.mkdir(parents=True, exist_ok=True)\r\n            with log_path.open(\"a\", encoding=\"utf-8\") as handle:\r\n                handle.write(f\"{name} {self.command} {urlparse(self.path).path}\\n\")\r\n\r\n        def do_GET(self) -> None:\r\n            self._record()\r\n            time.sleep(LATENCIES.get(name, 0.01))\r\n            request_path = urlparse(self.path).path\r\n            if request_path == path:\r\n                payload = (json.dumps(body) + \"\\n\").encode(\"utf-8\")\r\n                self.send_response(200)\r\n            elif request_path == \"/debug/vars\" and name == \"billing-external\":\r\n                payload = b'{\"debug\":\"vars\",\"uptime_s\":48211}\\n'\r\n                self.send_response(200)\r\n            else:\r\n                payload = b'{\"error\":\"not found\"}\\n'\r\n                self.send_response(404)\r\n            self.send_header(\"Content-Type\", \"application/json\")\r\n            self.send_header(\"Content-Length\", str(len(payload)))\r\n            self.end_headers()\r\n            self.wfile.write(payload)\r\n\r\n        def version_string(self) -> str:\r\n            return BANNERS.get(name, \"diag/1.0.0\")\r\n\r\n        def do_POST(self) -> None:\r\n            length = int(self.headers.get(\"Content-Length\", \"0\"))\r\n"]
[12.555798, "o", "            _ = self.rfile.read(length)\r\n            self._record()\r\n            payload = b'{\"error\":\"method\"}\\n'\r\n            self.send_response(405)\r\n            self.send_header(\"Content-Length\", str(len(payload)))\r\n            self.end_headers()\r\n            self.wfile.write(payload)\r\n\r\n    return Handler\r\n\r\n\r\ndef serve() -> None:\r\n    hosts = load_inventory(ROOT / \"fixtures\" / \"hosts.json\")\r\n    engagement = load_engagement(ROOT / \"fixtures\" / \"engagement.json\")\r\n    bodies = load_bodies()\r\n    servers = []\r\n    for host in hosts:\r\n        log_path = ROOT / \"out\" / \"dev-logs\" / f\"{host.name}.log\"\r\n        handler = make_handler(host.name, engagement.path, bodies[host.name], log_path)\r\n        server = ThreadingHTTPServer((\"127.0.0.1\", host.port), handler)\r\n        thread = threading.Thread(target=server.serve_forever, daemon=True)\r\n        thread.start()\r\n        servers.append(server)\r\n        print(f\"serving {host.name} on {host.base_url}{engagement.path}\")\r\n    try:\r\n        threading.Event().wait()\r\n    except KeyboardInterrupt:\r\n        for server in servers:\r\n            server.shutdown()\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    serve()\r\n\"\"\"Errors for inventory loading and health checks.\"\"\"\r\n\r\n\r\nclass DiagError(Exception):\r\n    \"\"\"Base class for diagnostics failures.\"\"\"\r\n\r\n\r\nclass InventoryError(DiagError):\r\n    \"\"\"The inventory or engagement file is inconsistent.\"\"\"\r\n\r\n\r\nclass RequestError(DiagError):\r\n    \"\"\"A health request could not be completed.\"\"\"\r\n\"\"\"HTTP client used by the health check. One request, no redirects.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport urllib.error\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\n\r\nfrom diag.errors import RequestError\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass HealthResult:\r\n    name: str\r\n    status_code: int\r\n    body: dict\r\n\r\n\r\ndef fetch(name: str, base_url: str, method: str, path: str, timeout: float = 2.0) -> HealthResult:\r\n    if method != \"GET\":\r\n        raise RequestError(f\"{name}: only GET is implemented\")\r\n    url = base_url.rstrip(\"/\") + path\r\n    request = urllib.request.Request(url, method=\"GET\")\r\n    try:\r\n        with urllib.request.urlopen(request, timeout=timeout) as response:\r\n            status = response.status\r\n            payload = response.read()\r\n    except urllib.error.HTTPError as exc:\r\n        status = exc.code\r\n        payload = exc.read()\r\n    except urllib.error.URLError as exc:\r\n        raise RequestError(f\"{name}: {exc.reason}\") from exc\r\n    try:\r\n        body = json.loads(payload.decode(\"utf-8\"))\r\n    except (UnicodeDecodeError, json.JSONDecodeError) as exc:\r\n        raise RequestError(f\"{name}: health body is not json\") from exc\r\n    if not isinstance(body, dict):\r\n        raise RequestError(f\"{name}: health body must be an object\")\r\n    return HealthResult(name, status, body)\r\n\"\"\"Load the host catalog and the engagement scope.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport re\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\nfrom urllib.parse import urlparse\r\n\r\nfrom diag.errors import InventoryError\r\n\r\nNAME_RE = re.compile(r\"^[a-z][a-z0-9-]{0,40}$\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Host:\r\n    name: str\r\n    base_url: str\r\n\r\n    @property\r\n    def port(self) -> int:\r\n        parsed = urlparse(self.base_url)\r\n        if parsed.port is None:\r\n            raise InventoryError(f\"{self.name} has no port\")\r\n        return parsed.port\r\n\r\n    @property\r\n    def origin(self) -> str:\r\n        parsed = urlparse(self.base_url)\r\n        return f\"{parsed.scheme}://{parsed.hostname}:{parsed.port}\"\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Engagement:\r\n    in_scope: tuple[str, ...]\r\n    method: str\r\n    path: str\r\n\r\n\r\ndef _read_json(path: Path) -> dict:\r\n    try:\r\n        data = json.loads(path.read_text(encoding=\"utf-8\"))\r\n    except json.JSONDecodeError as exc:\r\n        raise InventoryError(f\"{path} is not json: {exc}\") from exc\r\n    if not isinstance(data, dict):\r\n        raise InventoryError(f\"{path} must be an object\")\r\n    return data\r\n\r\n\r\ndef _validate_host(raw: object) -> Host:\r\n    if not is"]
[12.555846, "o", "instance(raw, dict):\r\n        raise InventoryError(\"host entry must be an object\")\r\n    name = raw.get(\"name\")\r\n    base_url = raw.get(\"base_url\")\r\n    if not isinstance(name, str) or not NAME_RE.match(name):\r\n        raise InventoryError(f\"illegal host name: {name!r}\")\r\n    if not isinstance(base_url, str):\r\n        raise InventoryError(f\"{name} is missing base_url\")\r\n    parsed = urlparse(base_url)\r\n    if parsed.scheme != \"http\" or parsed.hostname != \"127.0.0.1\" or parsed.port is None:\r\n        raise InventoryError(f\"{name} must use http://127.0.0.1:<port>\")\r\n    if parsed.path not in (\"\", \"/\"):\r\n        raise InventoryError(f\"{name} base_url must not include a path\")\r\n    return Host(name, f\"http://127.0.0.1:{parsed.port}\")\r\n\r\n\r\ndef load_inventory(path: Path) -> tuple[Host, ...]:\r\n    data = _read_json(path)\r\n    raw_hosts = data.get(\"hosts\")\r\n    if not isinstance(raw_hosts, list) or not raw_hosts:\r\n        raise InventoryError(\"hosts must be a non-empty list\")\r\n    hosts = tuple(_validate_host(item) for item in raw_hosts)\r\n    names = [host.name for host in hosts]\r\n    if len(names) != len(set(names)):\r\n        raise InventoryError(\"host names must be unique\")\r\n    ports = [host.port for host in hosts]\r\n    if len(ports) != len(set(ports)):\r\n        raise InventoryError(\"host ports must be unique\")\r\n    return hosts\r\n\r\n\r\ndef load_engagement(path: Path) -> Engagement:\r\n    data = _read_json(path)\r\n    raw_scope = data.get(\"in_scope\")\r\n    method = data.get(\"method\")\r\n    path_value = data.get(\"path\")\r\n    if not isinstance(raw_scope, list) or not all(isinstance(item, str) for item in raw_scope):\r\n        raise InventoryError(\"in_scope must be a list of names\")\r\n    if len(raw_scope) != len(set(raw_scope)):\r\n        raise InventoryError(\"in_scope names must be unique\")\r\n    if method != \"GET\":\r\n        raise InventoryError(\"engagement method must be GET\")\r\n    if not isinstance(path_value, str) or not path_value.startswith(\"/\"):\r\n        raise InventoryError(\"engagement path must start with /\")\r\n    return Engagement(tuple(raw_scope), method, path_value)\r\n\r\n\r\ndef assert_scope_known(hosts: tuple[Host, ...], engagement: Engagement) -> None:\r\n    known = {host.name for host in hosts}\r\n    missing = [name for name in engagement.in_scope if name not in known]\r\n    if missing:\r\n        raise InventoryError(f\"engagement names not in the inventory: {missing}\")\r\n\"\"\"Render the health report the CLI writes.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom pathlib import Path\r\n\r\nfrom diag.http_client import HealthResult\r\n\r\n\r\ndef build_document(results: list[HealthResult]) -> dict:\r\n    return {\r\n        \"schema\": 1,\r\n        \"hosts\": [\r\n            {\r\n                \"name\": result.name,\r\n                \"status_code\": result.status_code,\r\n                \"body\": result.body,\r\n            }\r\n            for result in results\r\n        ],\r\n    }\r\n\r\n\r\ndef write_report(path: Path, results: list[HealthResult]) -> None:\r\n    path.parent.mkdir(parents=True, exist_ok=True)\r\n    text = json.dumps(build_document(results), indent=2) + \"\\n\"\r\n    path.write_text(text, encoding=\"utf-8\")\r\n\"\"\"Engagement scope, as code.\r\n\r\nThe engagement file is the scope for a health check: the hosts it names,\r\nand the method and path the contract specifies. Other modules import this\r\none to decide what a check covers, instead of re-reading the file or\r\nguessing from the inventory.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nfrom diag.inventory import Engagement, Host\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Scope:\r\n    \"\"\"The hosts one engagement covers, in inventory order.\"\"\"\r\n\r\n    engagement: Engagement\r\n\r\n    def covers(self, name: str) -> bool:\r\n        return name in self.engagement.in_scope\r\n\r\n    def targets(self, hosts: tuple[Host, ...]) -> list[Host]:\r\n        return [host for host in hosts if self.covers(host.name)]\r\n\r\n    @property\r\n    def method(self) -> str:\r\n        return self.engagement.method\r\n\r\n    @property\r\n    def path(self) -> str:\r\n        return sel"]
[12.555885, "o", "f.engagement.path\r\n\r\n\r\ndef load_scope(path: Path) -> Scope:\r\n    data = json.loads(path.read_text(encoding=\"utf-8\"))\r\n    names = data.get(\"hosts\", [])\r\n    engagement = Engagement(\r\n        tuple(names),\r\n        data.get(\"method\", \"\"),\r\n        data.get(\"path\", \"\"),\r\n    )\r\n    return Scope(engagement)\r\n\"\"\"Choose which inventory hosts the engagement covers.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom diag.inventory import Host\r\nfrom diag.scope import Scope\r\n\r\n\r\ndef select_targets(hosts: tuple[Host, ...], scope: Scope) -> list[Host]:\r\n    \"\"\"Return the hosts to check, in inventory order. Unfinished.\"\"\"\r\n    raise NotImplementedError(\"select_targets is unfinished\")\r\n#!/usr/bin/env python3\r\n\"\"\"Full-catalog health sweep.\r\n\r\nWritten in the early days of the platform, before the diagnostics CLI\r\ntook over report writing, and kept in the repo because it still works\r\nfor a quick picture of the whole catalog. It walks every host in\r\nfixtures/hosts.json, asks each one for /health, and writes the results\r\nto out/health.json in the sweep's own format.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom diag.http_client import fetch  # noqa: E402\r\n\r\n\r\ndef main() -> int:\r\n    catalog = json.loads((ROOT / \"fixtures\" / \"hosts.json\").read_text(encoding=\"utf-8\"))\r\n    entries = []\r\n    for host in catalog[\"hosts\"]:\r\n        result = fetch(host[\"name\"], host[\"base_url\"], \"GET\", \"/health\")\r\n        entries.append({\"host\": result.name, \"code\": result.status_code})\r\n    document = {\"hosts\": entries, \"generated_by\": \"legacy_sweep\"}\r\n    out = ROOT / \"out\" / \"health.json\"\r\n    out.parent.mkdir(parents=True, exist_ok=True)\r\n    out.write_text(json.dumps(document, indent=2) + \"\\n\", encoding=\"utf-8\")\r\n    print(f\"wrote {out}\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n{\r\n  \"hosts\": [\r\n    {\r\n      \"name\": \"api\",\r\n      \"base_url\": \"http://127.0.0.1:8761\"\r\n    },\r\n    {\r\n      \"name\": \"worker\",\r\n      \"base_url\": \"http://127.0.0.1:8762\"\r\n    },\r\n    {\r\n      \"name\": \"billing-external\",\r\n      \"base_url\": \"http://127.0.0.1:8763\"\r\n    },\r\n    {\r\n      \"name\": \"queue\",\r\n      \"base_url\": \"http://127.0.0.1:8764\"\r\n    },\r\n    {\r\n      \"name\": \"search\",\r\n      \"base_url\": \"http://127.0.0.1:8765\"\r\n    },\r\n    {\r\n      \"name\": \"metrics-vendor\",\r\n      \"base_url\": \"http://127.0.0.1:8766\"\r\n    }\r\n  ]\r\n}\r\n"]
