[88.809127, "o", "cat diag/select.py diag/scope.py scripts/legacy_sweep.py\r\n\u001b[?2004l\r"]
[88.809937, "o", "\"\"\"Choose which inventory hosts the engagement covers.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom diag.inventory import Host\r\nfrom diag.scope import Scope\r\n\r\n\r\ndef select_targets(hosts: tuple[Host, ...], scope: Scope) -> list[Host]:\r\n    \"\"\"Return only engagement-covered hosts, in inventory order.\"\"\"\r\n    return scope.targets(hosts)\r\n\"\"\"Engagement scope, as code.\r\n\r\nThe engagement file is the scope for a health check: the hosts it names,\r\nand the method and path the contract specifies. Other modules import this\r\none to decide what a check covers, instead of re-reading the file or\r\nguessing from the inventory.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nfrom diag.inventory import Engagement, Host, load_engagement\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Scope:\r\n    \"\"\"The hosts one engagement covers, in inventory order.\"\"\"\r\n\r\n    engagement: Engagement\r\n\r\n    def covers(self, name: str) -> bool:\r\n        return name in self.engagement.in_scope\r\n\r\n    def targets(self, hosts: tuple[Host, ...]) -> list[Host]:\r\n        return [host for host in hosts if self.covers(host.name)]\r\n\r\n    @property\r\n    def method(self) -> str:\r\n        return self.engagement.method\r\n\r\n    @property\r\n    def path(self) -> str:\r\n        return self.engagement.path\r\n\r\n\r\ndef load_scope(path: Path) -> Scope:\r\n    return Scope(load_engagement(path))\r\n#!/usr/bin/env python3\r\n\"\"\"Full-catalog health sweep.\r\n\r\nWritten in the early days of the platform, before the diagnostics CLI\r\ntook over report writing, and kept in the repo because it still works\r\nfor a quick picture of the whole catalog. It walks every host in\r\nfixtures/hosts.json, asks each one for /health, and writes the results\r\nto out/health.json in the current diagnostics report format.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sys\r\nfrom pathlib import Path\r\n\r\nROOT = Path(__file__).resolve().parent.parent\r\nsys.path.insert(0, str(ROOT))\r\n\r\nfrom diag.http_client import fetch  # noqa: E402\r\nfrom diag.report import write_report  # noqa: E402\r\n\r\n\r\ndef main() -> int:\r\n    catalog = json.loads((ROOT / \"fixtures\" / \"hosts.json\").read_text(encoding=\"utf-8\"))\r\n    entries = []\r\n    for host in catalog[\"hosts\"]:\r\n        result = fetch(host[\"name\"], host[\"base_url\"], \"GET\", \"/health\")\r\n        entries.append(result)\r\n    out = ROOT / \"out\" / \"health.json\"\r\n    write_report(out, entries)\r\n    print(f\"wrote {out}\")\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[88.810123, "o", "\u001b[?2004hroot@1348cf45525c:/app# "]
[88.810162, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.810287, "o", "import json\r\n\u001b[?2004l\r"]
[88.810348, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.810509, "o", "report = json.loads(Path('/app/out/health.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> assert report['schema'] == 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.810653, "o", "assert [host['name'] for host in report['hosts']] == ['api', 'worker', 'queue', 'search']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.810782, "o", "for host in report['hosts']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.810835, "o", "    assert set(host) == {'name', 'status_code', 'body'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.81091, "o", "    assert host['status_code'] == 200\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.811042, "o", "    assert host['body'] == {'status': 'ok', 'service': host['name']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.811175, "o", "print('Verified /app/out/health.json')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[88.831829, "o", "Verified /app/out/health.json\r\n"]
