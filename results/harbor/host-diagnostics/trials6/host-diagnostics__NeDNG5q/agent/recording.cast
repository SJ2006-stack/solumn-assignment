[16.721161, "o", "{\r\n  \"hosts\": [\r\n    {\r\n      \"name\": \"api\",\r\n      \"base_url\": \"http://127.0.0.1:8761\"\r\n    },\r\n    {\r\n      \"name\": \"worker\",\r\n      \"base_url\": \"http://127.0.0.1:8762\"\r\n    },\r\n    {\r\n      \"name\": \"billing-external\",\r\n      \"base_url\": \"http://127.0.0.1:8763\"\r\n    },\r\n    {\r\n      \"name\": \"queue\",\r\n      \"base_url\": \"http://127.0.0.1:8764\"\r\n    },\r\n    {\r\n      \"name\": \"search\",\r\n      \"base_url\": \"http://127.0.0.1:8765\"\r\n    },\r\n    {\r\n      \"name\": \"metrics-vendor\",\r\n      \"base_url\": \"http://127.0.0.1:8766\"\r\n    }\r\n  ]\r\n}\r\n"]
