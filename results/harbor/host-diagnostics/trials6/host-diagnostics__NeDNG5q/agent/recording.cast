[78.047886, "i", "python3 -m diag.cli\nCLI_STATUS=$?\nkill \"$DIAG_SERVER_PID\" 2>/dev/null || true\nwait \"$DIAG_SERVER_PID\" 2>/dev/null || true\nprintf 'CLI exit status: %s\\n' \"$CLI_STATUS\"\ncat /tmp/diag-devserver.log\ncat out/health.json\npython3 - <<'PY'\nimport json\nfrom pathlib import Path\nreport = json.loads(Path('out/health.json').read_text())\nbodies = json.loads(Path('fixtures/health_bodies.json').read_text())\nassert report['schema'] == 1\nassert [h['name'] for h in report['hosts']] == ['api', 'worker', 'queue', 'search']\nfor host in report['hosts']:\n    assert host['status_code'] == 200\n    assert host['body'] == bodies[host['name']]\nprint('Report verified')\nPY\nfind out/dev-logs -type f -maxdepth 1 -print -exec cat {} \\; 2>/dev/null\n"]
[78.048598, "o", "python3 -m diag.cli\r\n\u001b[?2004l\r"]
