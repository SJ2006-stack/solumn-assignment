[49.816411, "i", "mkdir -p tests; cat > tests/test_health.py <<'PY'\nimport json\nfrom pathlib import Path\nimport tempfile\nimport unittest\nfrom unittest.mock import call, patch\n\nfrom diag import cli\nfrom diag.errors import InventoryError\nfrom diag.http_client import HealthResult\nfrom diag.inventory import Engagement, Host, load_inventory\nfrom diag.scope import Scope, load_scope\nfrom diag.select import select_targets\nfrom scripts import legacy_sweep\n\nROOT = Path(__file__).resolve().parents[1]\n\n\nclass HealthTests(unittest.TestCase):\n    def test_selection_follows_inventory_not_scope_order(self):\n        hosts = tuple(Host(name, f'http://127.0.0.1:{9000 + i}')\n                      for i, name in enumerate(('a', 'excluded', 'b')))\n        scope = Scope(Engagement(('b', 'a'), 'GET', '/health'))\n        self.assertEqual(select_targets(hosts, scope), [hosts[0], hosts[2]])\n        self.assertEqual(select_targets(hosts, Scope(Engagement((), 'GET', '/health'))), [])\n        self.assertEqual(select_targets((), scope), [])\n\n    def test_fixture_scope(self):\n        scope = load_scope(ROOT / 'fixtures/engagement.json')\n        hosts = load_inventory(ROOT / 'fixtures/hosts.json')\n        self.assertEqual([host.name for host in select_targets(hosts, scope)],\n                         ['api', 'worker', 'queue', 'search'])\n        self.assertEqual((scope.method, scope.path), ('GET', '/health'))\n\n    def test_scope_uses_existing_validation(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / 'engagement.json'\n            for document in (\n                {'in_scope': ['api', 'api'], 'method': 'GET', 'path': '/health'},\n                {'in_scope': ['api'], 'method': 'POST', 'path': '/health'},\n            ):\n                path.write_text(json.dumps(document))\n                with self.assertRaises(InventoryError):\n                    load_scope(path)\n\n    def test_cli_report_and_requests(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            root = Path(tmp)\n            (root / 'fixtures').mkdir()\n            for name in ('hosts.json', 'engagement.json'):\n                (root / 'fixtures' / name).write_bytes((ROOT / 'fixtures' / name).read_bytes())\n            names = ['api', 'worker', 'queue', 'search']\n            results = [HealthResult(name, 200, {'service': name}) for name in names]\n            with patch.object(cli, 'ROOT', root), patch.object(cli, 'fetch', side_effect=results) as fetch:\n                self.assertEqual(cli.run(), 0)\n            hosts = load_inventory(root / 'fixtures/hosts.json')\n            self.assertEqual(fetch.call_args_list,\n                             [call(h.name, h.base_url, 'GET', '/health') for h in hosts if h.name in names])\n            document = json.loads((root / 'out/health.json').read_text())\n            self.assertEqual(document, {'schema': 1, 'hosts': [\n                {'name': r.name, 'status_code': r.status_code, 'body': r.body} for r in results]})\n\n    def test_legacy_format_preserves_full_catalog_sweep(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            root = Path(tmp)\n            (root / 'fixtures').mkdir()\n            catalog = json.loads((ROOT / 'fixtures/hosts.json').read_text())\n            (root / 'fixtures/hosts.json').write_text(json.dumps(catalog))\n            results = [HealthResult(h['name'], 503, {'ok': False, 'nested': {'value': 1}})\n                       for h in catalog['hosts']]\n            with patch.object(legacy_sweep, 'ROOT', root), patch.object(legacy_sweep, 'fetch', side_effect=results) as fetch, patch('builtins.print') as output:\n                self.assertEqual(legacy_sweep.main(), 0)\n            self.assertEqual(fetch.call_args_list, [\n                call(h['name'], h['base_url'], 'GET', '/health') for h in catalog['hosts']])\n            output.assert_called_once_with(f'wrote {root / \"out/health.json\"}')\n            self.assertEqual(json.loads((root / 'out/health.json').read_text()), {\n                'schema': 1, 'hosts': [\n                    {'name': r.name, 'status_code': r.status_code, 'body': r.body} for r "]
[49.816983, "i", "in results]})\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython -m unittest discover -s tests -v\n"]
