[46.083359, "o", "\u001b[?2004h> s = p.read_text().replace('\"\"\"Return the hosts to check, in inventory order. Unfinished.\"\"\"\\n    raise NotImplementedError(\"select_targets is unfinished\")', '\"\"\"Return only the engagement hosts, in inventory order.\"\"\"\\n    return scope.targets(hosts)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('diag/scope.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('import json\\n', '').replace('from diag.inventory import Engagement, Host', 'from diag.inventory import Engagement, Host, load_engagement')\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('    data = json.loads', s.index('def load_scope('))\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '    return Scope(load_engagement(path))\\n'\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('scripts/legacy_sweep.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace(\"to out/health.json in the sweep's own format.\", 'to out/health.json in the current diagnostics report format.')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('from diag.http_client import fetch  # noqa: E402', 'from diag.http_client import fetch  # noqa: E402\\nfrom diag.report import write_report  # noqa: E402')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('entries.append({\"host\": result.name, \"code\": result.status_code})', 'entries.append(result)')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    document = {\"hosts\": entries, \"generated_by\": \"legacy_sweep\"}\\n', '')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    out.parent.mkdir(parents=True, exist_ok=True)\\n    out.write_text(json.dumps(document, indent=2) + \"\\\\n\", encoding=\"utf-8\")', '    write_report(out, entries)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
