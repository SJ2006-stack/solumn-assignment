[63.089005, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\nroot = Path('/app')\nreport = json.loads((root / 'out/health.json').read_text())\nbodies = json.loads((root / 'fixtures/health_bodies.json').read_text())\nassert report['schema'] == 1\nassert [entry['name'] for entry in report['hosts']] == ['api', 'worker', 'queue', 'search']\nfor entry in report['hosts']:\n    assert set(entry) == {'name', 'status_code', 'body'}\n    assert entry['status_code'] == 200\n    assert entry['body'] == bodies[entry['name']]\nprint('Report verified: /app/out/health.json')\nPY\nkill \"$DIAG_DEVSERVER_PID\"\nwait \"$DIAG_DEVSERVER_PID\" 2>/dev/null || true\ncat diag/select.py diag/scope.py scripts/legacy_sweep.py\n"]
[63.091331, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.092799, "o", "> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> root = Path('/app')\r\n\u001b[?2004l\r\u001b[?2004h> report = json.loads((root / 'out/health.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> bodies = json.loads((root / 'fixtures/health_bodies.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> assert report['schema'] == 1\r\n\u001b[?2004l\r\u001b[?2004h> assert [entry['name'] for entry in report['hosts']] == ['api', 'worker', 'queue', 'search']\r\n\u001b[?2004l\r\u001b[?2004h> for entry in report['hosts']:\r\n\u001b[?2004l\r\u001b[?2004h>     assert set(entry) == {'name', 'status_code', 'body'}\r\n\u001b[?2004l\r\u001b[?2004h>     assert entry['status_code'] == 200\r\n\u001b[?2004l\r\u001b[?2004h>     assert entry['body'] == bodies[entry['name']]\r\n\u001b[?2004l\r\u001b[?2004h> print('Report verified: /app/out/health.json')\r\n\u001b[?2004l\r"]
[63.092854, "o", "\u001b[?2004h> "]
