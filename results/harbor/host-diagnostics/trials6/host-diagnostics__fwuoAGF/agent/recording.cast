[46.230123, "i", "mkdir -p tests\ncat > tests/test_health.py <<'PY'\nimport contextlib\nimport io\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import call, patch\n\nfrom diag import cli\nfrom diag.errors import InventoryError\nfrom diag.http_client import HealthResult\nfrom diag.inventory import Engagement, Host, load_inventory\nfrom diag.report import build_document\nfrom diag.scope import Scope, load_scope\nfrom diag.select import select_targets\nfrom scripts import legacy_sweep\n\nROOT = Path(__file__).resolve().parents[1]\n\n\nclass HealthTests(unittest.TestCase):\n    def test_selection_uses_scope_in_inventory_order(self):\n        hosts = (\n            Host('api', 'http://127.0.0.1:8761'),\n            Host('other', 'http://127.0.0.1:8763'),\n            Host('worker', 'http://127.0.0.1:8762'),\n        )\n        scope = Scope(Engagement(('worker', 'api'), 'GET', '/health'))\n        self.assertEqual(select_targets(hosts, scope), [hosts[0], hosts[2]])\n        self.assertEqual(select_targets(hosts, Scope(Engagement((), 'GET', '/health'))), [])\n        self.assertEqual(select_targets((), scope), [])\n        self.assertEqual(len(hosts), 3)\n\n    def test_fixture_scope(self):\n        hosts = load_inventory(ROOT / 'fixtures/hosts.json')\n        scope = load_scope(ROOT / 'fixtures/engagement.json')\n        self.assertEqual([h.name for h in select_targets(hosts, scope)],\n                         ['api', 'worker', 'queue', 'search'])\n        self.assertEqual((scope.method, scope.path), ('GET', '/health'))\n\n    def test_scope_uses_existing_validation(self):\n        invalid = [\n            {'hosts': ['api'], 'method': 'GET', 'path': '/health'},\n            {'in_scope': ['api', 'api'], 'method': 'GET', 'path': '/health'},\n            {'in_scope': ['api'], 'method': 'POST', 'path': '/health'},\n            {'in_scope': ['api'], 'method': 'GET', 'path': 'health'},\n        ]\n        with tempfile.TemporaryDirectory() as tmp:\n            path = Path(tmp) / 'engagement.json'\n            for document in invalid:\n                with self.subTest(document=document):\n                    path.write_text(json.dumps(document))\n                    with self.assertRaises(InventoryError):\n                        load_scope(path)\n\n    def make_root(self, root):\n        (root / 'fixtures').mkdir()\n        for name in ('hosts.json', 'engagement.json'):\n            (root / 'fixtures' / name).write_bytes((ROOT / 'fixtures' / name).read_bytes())\n\n    def test_cli_only_fetches_engagement_and_writes_report(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            root = Path(tmp)\n            self.make_root(root)\n            # Scope order differs from inventory order; path must come from scope.\n            (root / 'fixtures/engagement.json').write_text(json.dumps({\n                'in_scope': ['search', 'api'], 'method': 'GET', 'path': '/ready',\n            }))\n            results = [HealthResult('api', 200, {'status': 'ok'}),\n                       HealthResult('search', 503, {'status': 'degraded'})]\n            with patch.object(cli, 'ROOT', root), patch.object(cli, 'fetch', side_effect=results) as fetch:\n                self.assertEqual(cli.run(), 0)\n            self.assertEqual(fetch.call_args_list, [\n                call('api', 'http://127.0.0.1:8761', 'GET', '/ready'),\n                call('search', 'http://127.0.0.1:8765', 'GET', '/ready'),\n            ])\n            self.assertEqual(json.loads((root / 'out/health.json').read_text()), build_document(results))\n\n    def test_cli_rejects_unknown_scope_before_fetching(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            root = Path(tmp)\n            self.make_root(root)\n            (root / 'fixtures/engagement.json').write_text(json.dumps({\n                'in_scope': ['unknown'], 'method': 'GET', 'path': '/health',\n            }))\n            with patch.object(cli, 'ROOT', root), patch.object(cli, 'fetch') as fetch:\n                with self.assertRaises(InventoryError):\n                    cli.run()\n                fetch.assert_not_called()\n\n    def test_legacy_pre"]
[46.230177, "i", "serves_requests_and_uses_current_schema(self):\n        with tempfile.TemporaryDirectory() as tmp:\n            root = Path(tmp)\n            self.make_root(root)\n            hosts = load_inventory(root / 'fixtures/hosts.json')\n            results = [HealthResult(h.name, 503 if i == 0 else 200,\n                                    {'service': h.name, 'nested': {'ok': i != 0}})\n                       for i, h in enumerate(hosts)]\n            with patch.object(legacy_sweep, 'ROOT', root), \\\n                 patch.object(legacy_sweep, 'fetch', side_effect=results) as fetch, \\\n                 contextlib.redirect_stdout(io.StringIO()):\n                self.assertEqual(legacy_sweep.main(), 0)\n            self.assertEqual(fetch.call_args_list,\n                             [call(h.name, h.base_url, 'GET', '/health') for h in hosts])\n            document = json.loads((root / 'out/health.json').read_text())\n            self.assertEqual(document, build_document(results))\n            self.assertEqual(set(document), {'schema', 'hosts'})\n            self.assertEqual(document['schema'], 1)\n            self.assertEqual(set(document['hosts'][0]), {'name', 'status_code', 'body'})\n\n\nif __name__ == '__main__':\n    unittest.main()\nPY\npython3 -m unittest discover -s tests -v\n"]
